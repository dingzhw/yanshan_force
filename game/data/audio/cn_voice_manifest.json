    "saeed_06": {
      "id": "saeed_06",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "tag": "skill_bolt",
      "file": "saeed_06.ogg",
      "text": "尝尝我的燃烧弩箭，烧断你的退路！",

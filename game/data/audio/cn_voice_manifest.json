      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "tag": "proximity",
      "file": "saeed_02.ogg",
      "text": "我看到你了，小耗子！",
      "bytes": 17169,
      "sha256": "cc7c52fe1711177c7b54b821d13878d4c51e4d53cc54b74c6d5bd123fbc6644e"

      "sha256": "6bc915afb06469f0a036fe4eabd32442a2abbe128d7ca3bf72f78e2855b3a0a1"
    },
    "saeed_04": {
      "id": "saeed_04",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "tag": "proximity",
      "file": "saeed_04.ogg",
      "text": "赤枭的领地，轮不到外来者撒野！",

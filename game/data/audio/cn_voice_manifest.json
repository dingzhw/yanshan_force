  "entries": {
    "ag_01": {
      "id": "ag_01",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "proximity",
      "file": "ag_01.ogg",
      "text": "来！咱俩练练！",
      "bytes": 13996,
      "sha256": "335f344788e8b0ad8cf42c186e17f461eb02ba5fd08df1ff9c456bda37d1ff7f"
    },
    "ag_02": {
      "id": "ag_02",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "combat",
      "file": "ag_02.ogg",
      "text": "别让他们跑了，围上去！",
      "bytes": 16759,
      "sha256": "73ab170bb732b47959a26ca2e8ee2fc10b783f2e2e1013f3f87451ac16aa28dd"
    },
    "ag_03": {
      "id": "ag_03",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "combat",
      "file": "ag_03.ogg",
      "text": "守住防线，都给我顶上去！",
      "bytes": 18771,
      "sha256": "ce5c42df17a5678ef706c775b283c05bc8227563af4c2a7a39ea5763e2ed7df3"
    },
    "ag_04": {
      "id": "ag_04",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "proximity",
      "file": "ag_04.ogg",
      "text": "发现外来者！注意掩体，准备开火！",
      "bytes": 26577,
      "sha256": "fbd44be7f1133fafe71c2f08e7a5ad50c934c0b032769bea1fa404951ca42724"
    },
    "ag_05": {
      "id": "ag_05",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "proximity",
      "file": "ag_05.ogg",
      "text": "阿萨拉的地盘，可不是你想来就来的！",
      "bytes": 22802,
      "sha256": "162c46b66c55b47d0269e801426920bb9cd1d45f42a4d4dd82992f67b81821e5"
    },
    "ag_06": {
      "id": "ag_06",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "combat",
      "file": "ag_06.ogg",
      "text": "快掩护我换位，别露破绽！",
      "bytes": 18499,
      "sha256": "fa710fbe6a62b5b1fde1e414a2a483c7993e5fdb9ef17a6630ab00effb25e755"
    },
    "ag_07": {
      "id": "ag_07",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "combat",
      "file": "ag_07.ogg",
      "text": "小心侧翼包抄，把词盾撑紧了！",
      "bytes": 21763,
      "sha256": "9156f2c4b332334b1dcb3ec62db2d0134482b93e4dfe26971d54d5a0ca91567b"
    },
    "ag_08": {
      "id": "ag_08",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "voice_actor": "zh-CN-YunjianNeural",
      "timbre": "gruff_desert_mercenary",
      "tag": "proximity",
      "file": "ag_08.ogg",
      "text": "哟，还挺能躲的，咱俩接着练！",
      "bytes": 22772,
      "sha256": "94d1497b419790f787564e9b6e70286a4c8353749b8704f6385f0f0d29e4ce77"
    },
    "saeed_01": {
      "id": "saeed_01",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "intro",
      "file": "saeed_01.ogg",
      "text": "父亲教导我，好的猎人懂得尊重猎物……但你，不配！",
      "bytes": 29601,
      "sha256": "48bae1be84e7b4a339a06d6260269eced40434adb711d7a7d84b22ced157cc4a"
    },
    "saeed_02": {
      "id": "saeed_02",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "proximity",
      "file": "saeed_02.ogg",
      "text": "我看到你了，小耗子！",
      "bytes": 14408,
      "sha256": "c42e288d4dda9319a285ac4ecf892455bfa85460e5de6083eb7f586fd1a90b02"
    },
    "saeed_03": {
      "id": "saeed_03",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "combat",
      "file": "saeed_03.ogg",
      "text": "你掉进陷阱里了！",
      "bytes": 13025,
      "sha256": "e3da6ae9a8f78e27584e5d13c1ddc6694fdd636c5ff453e5f6231e33084c7cca"
    },
    "saeed_04": {
      "id": "saeed_04",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "proximity",
      "file": "saeed_04.ogg",
      "text": "赤枭的领地，轮不到外来者撒野！",
      "bytes": 20115,
      "sha256": "7f31d6f9ed5001806ca1bfe1f2ca9cb1b0c28c535034bd8f712d089d313a3963"
    },
    "saeed_05": {
      "id": "saeed_05",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "skill_lmg",
      "file": "saeed_05.ogg",
      "text": "M249 火力压制！看你往哪儿躲！",
      "bytes": 21551,
      "sha256": "06580f3cc6298a6d9f32b5c5a5a9af29f25fcbc566c6a7911be7ee4bc967aa39"
    },
    "saeed_06": {
      "id": "saeed_06",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "skill_bolt",
      "file": "saeed_06.ogg",
      "text": "尝尝我的燃烧弩箭，烧断你的退路！",
      "bytes": 20201,
      "sha256": "b333f62ad42db095d34a29cbff75a5e614e1b499870cc8c9541346d98e3f2380"
    },
    "saeed_07": {
      "id": "saeed_07",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "skill_smoke",
      "file": "saeed_07.ogg",
      "text": "烟幕掩护，换位包抄！",
      "bytes": 15333,
      "sha256": "34e0fe90f568d328835c7375436071e1531def9fbda070ee22def9ec08e47949"
    },
    "saeed_08": {
      "id": "saeed_08",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "phase",
      "file": "saeed_08.ogg",
      "text": "有两下子，居然破了我的词盾！",
      "bytes": 18215,
      "sha256": "135f3a52c6cc372b756b212a4107dc5016fd69f9a684e58354bf7cc15ee21fdf"
    },
    "saeed_09": {
      "id": "saeed_09",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "proximity",
      "file": "saeed_09.ogg",
      "text": "想带走曼德尔砖？先问问我手里的枪！",
      "bytes": 23176,
      "sha256": "9335aa3d204e91d057328ae94a675b09dffc637534e26715bb1b9ca05de155b3"
    },
    "saeed_10": {
      "id": "saeed_10",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "voice_actor": "zh-CN-YunxiaNeural",
      "timbre": "predatory_hunter_baritone",
      "tag": "combat",
      "file": "saeed_10.ogg",
      "text": "还站得起来？那就继续，小耗子！",
      "bytes": 23193,
      "sha256": "7b96ff234d66f7c54308d1d450bac0033c406251e1d42e21c210caa9a659cfc6"
    },
    "reis_01": {
      "id": "reis_01",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "intro",
      "file": "reis_01.ogg",
      "text": "把留声机开大声点！没有交响乐的战场，简直粗俗不堪！",
      "bytes": 36224,
      "sha256": "f7a6b6fecf19be59fe0fecc33f5980e63516f1dc4ca2d8c328e7004bf0af249d"
    },
    "reis_02": {
      "id": "reis_02",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "proximity",
      "file": "reis_02.ogg",
      "text": "在阿萨拉，规矩由枪口和黄金说了算！",
      "bytes": 26352,
      "sha256": "e72222990e8a27b3c79e82a743d29b450893beeacbbc4d48ac4480c578aaf29d"
    },
    "reis_03": {
      "id": "reis_03",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "skill_sonic",
      "file": "reis_03.ogg",
      "text": "听听这首交响乐，专为你的撤离倒计时准备的！",
      "bytes": 27245,
      "sha256": "af3c8d225cdd01bb6094607c11016f0b2ae2d4613803cdddb0ef86b252b690ce"
    },
    "reis_04": {
      "id": "reis_04",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "skill_shotgun",
      "file": "reis_04.ogg",
      "text": "重甲突击！尝尝霰弹枪的滋味！",
      "bytes": 23411,
      "sha256": "8cf09f48abd3a2a4f89752f0ef75588a091ec67d5c48f3acb3067039258e9141"
    },
    "reis_05": {
      "id": "reis_05",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "skill_grenade",
      "file": "reis_05.ogg",
      "text": "送你三颗破片手雷，跟着节奏跳支舞吧！",
      "bytes": 25412,
      "sha256": "1e6172bd1a632853c0b5dc5de9ac22851c0c45ba743aa3a48385e5514da43de9"
    },
    "reis_06": {
      "id": "reis_06",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "phase",
      "file": "reis_06.ogg",
      "text": "近卫们！出来好好招待一下我们的贵客！",
      "bytes": 25350,
      "sha256": "e1d0495bd5ba1838111f3f6666c5433bbe0f52eb52a37fca971787defa1698e3"
    },
    "reis_07": {
      "id": "reis_07",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "skill_ult",
      "file": "reis_07.ogg",
      "text": "零号大坝听令！重炮泄洪，全区覆盖！",
      "bytes": 27055,
      "sha256": "d965be88c6c1841e0b6cfb3a32bd1e2461ccbe216878d6bb978044a8dffa5f26"
    },
    "reis_08": {
      "id": "reis_08",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "combat",
      "file": "reis_08.ogg",
      "text": "哈哈哈，居然撑过了零号大坝的炮火！",
      "bytes": 22225,
      "sha256": "a070e87c487ad18284d29a5a435bfb252cef0f6da6595dafbb3c032a98544299"
    },
    "reis_09": {
      "id": "reis_09",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "proximity",
      "file": "reis_09.ogg",
      "text": "非洲之心，岂是你能轻易带走的？",
      "bytes": 21394,
      "sha256": "5a2e65215c282fc1f3c838fd849e804625e35a464368108dab33f5a310cc54ca"
    },
    "reis_10": {
      "id": "reis_10",
      "group": "boss_reis",
      "speaker": "阿萨拉军阀·雷斯",
      "voice_actor": "zh-CN-YunyangNeural",
      "timbre": "booming_warlord_gramophone_hall",
      "tag": "combat",
      "file": "reis_10.ogg",
      "text": "不错！你配听完这最后一曲！",
      "bytes": 20413,
      "sha256": "e16fccefe8c516daae76c2554a9daf32319e7ae4292ec120ef06c60b19b8ac82"
    },
    "haavk_01": {
      "id": "haavk_01",
      "group": "haavk_trooper",
      "speaker": "哈夫克特勤",
      "voice_actor": "zh-CN-XiaoxiaoNeural",
      "timbre": "cold_corporate_female_radio",
      "tag": "proximity",
      "file": "haavk_01.ogg",
      "text": "警告，未授权目标进入哈夫克管制区。",
      "bytes": 23464,
      "sha256": "1b1205403339f6ae166f3c3a8742063d9bd286f757cd288c09952976aed551a5"
    },
    "haavk_02": {
      "id": "haavk_02",
      "group": "haavk_trooper",
      "speaker": "哈夫克特勤",
      "voice_actor": "zh-CN-XiaoxiaoNeural",
      "timbre": "cold_corporate_female_radio",
      "tag": "combat",
      "file": "haavk_02.ogg",
      "text": "安保协议三级启动，展开全息词盾阵列。",
      "bytes": 24710,

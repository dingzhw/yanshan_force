    "ag_01": {
      "id": "ag_01",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "proximity",
      "file": "ag_01.ogg",
      "text": "来！咱俩练练！",
      "bytes": 15713,
      "sha256": "d59c2e66fbd1ab6ac50ee94f39330de99fac4e128f41c8af9affafe1da5264b0"
    },
    "ag_02": {
      "id": "ag_02",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "combat",
      "file": "ag_02.ogg",
      "text": "别让他们跑了，围上去！",
      "bytes": 13526,
      "sha256": "e33421f44c895e3387fbecbf99953ffd0fd337ac4dd54b43596d11415f472b0d"
    },
    "ag_03": {
      "id": "ag_03",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "combat",
      "file": "ag_03.ogg",
      "text": "守住防线，都给我顶上去！",
      "bytes": 15916,
      "sha256": "d76e25454230fa63c0cc809c574bf55a100ffb5cbe88bb7cbce8e8bca1d9e2cf"
    },
    "ag_04": {
      "id": "ag_04",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "proximity",
      "file": "ag_04.ogg",
      "text": "发现外来者！注意掩体，准备开火！",
      "bytes": 24816,
      "sha256": "b28e904681e2807f720d3b7ff70632364d744e740b44f5643c4076575486b939"
    },
    "ag_05": {
      "id": "ag_05",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "proximity",
      "file": "ag_05.ogg",
      "text": "阿萨拉的地盘，可不是你想来就来的！",
      "bytes": 21159,
      "sha256": "022f82b14ebbd5c5aef4c962f5bb1f94b05720fe0318c557f175f79344109f68"
    },
    "ag_06": {
      "id": "ag_06",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "combat",
      "file": "ag_06.ogg",
      "text": "快掩护我换位，别露破绽！",
      "bytes": 14625,
      "sha256": "61bfdc553f1141423b4745de3774f10d8e68b5ff1c474f5f13acdacbc74ecf27"
    },
    "ag_07": {
      "id": "ag_07",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "combat",
      "file": "ag_07.ogg",
      "text": "小心侧翼包抄，把词盾撑紧了！",
      "bytes": 20272,
      "sha256": "56864b3fa33b8222494a82034563de70219836795bfea05f98249bdc05e38027"
    },
    "ag_08": {
      "id": "ag_08",
      "group": "ahsarah_guard",
      "speaker": "阿萨拉卫队",
      "tag": "proximity",
      "file": "ag_08.ogg",
      "text": "哟，还挺能躲的，咱俩接着练！",
      "bytes": 21137,
      "sha256": "f634cacb8e13e906323c09620fd5409cca3c56bbfacddfa17f058464b48798e5"
    },
    "saeed_01": {
      "id": "saeed_01",
      "group": "boss_saeed",
      "speaker": "赤枭·赛伊德",
      "tag": "intro",
      "file": "saeed_01.ogg",
      "text": "父亲教导我，好的猎人懂得尊重猎物……但你，不配！",
      "bytes": 37608,
      "sha256": "e5769563f35b3b803f5224bcafd31ddc8705ff000710992cde12562c387018b2"
    },
